<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Nimbus.Core\Nimbus.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Strategy files are shared with the Mac app; tests run against the real ones. -->
    <None Include="..\..\..\macos\Payload\strategies.tsv" Link="payload\strategies.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\macos\Payload\strategies\*.conf.in" Link="payload\strategies\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\macos\Payload\default-lists\*.txt" Link="payload\default-lists\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
