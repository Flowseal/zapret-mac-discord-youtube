#!/bin/sh
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
[ "${3:-/}" = / ] || exit 1
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
OWNER_UID=$("$SCRIPT_DIR/setup-check")
OWNER_NAME=$(/usr/bin/id -nu "$OWNER_UID")
APP='/Applications/ZapretMac.app'
[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$APP/Contents/Info.plist")" = 'io.github.flowseal.zapretmac.app' ] || exit 1
[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$APP/Contents/Info.plist")" = '1.1.2' ] || exit 1
/usr/bin/killall -u "$OWNER_NAME" ZapretMac >/dev/null 2>&1 || true
