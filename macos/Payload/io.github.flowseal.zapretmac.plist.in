<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.flowseal.zapretmac</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/ZapretMac/run.sh</string>
        <string>@DATA_ROOT@</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>2</integer>
    <key>StandardOutPath</key>
    <string>/Library/Application Support/ZapretMac/zapret.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Application Support/ZapretMac/zapret.log</string>
</dict>
</plist>
